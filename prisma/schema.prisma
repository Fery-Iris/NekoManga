generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  email         String?   @unique
  name          String?
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  bookmarks     Bookmark[]
  histories     History[]
  comments      Comment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Bookmark {
  id             String   @id @default(uuid())
  userId         String
  comicEndpoint  String
  comicName      String
  comicThumbnail String?
  comicType      String?
  createdAt      DateTime @default(now())
  
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, comicEndpoint])
}

model History {
  id              String   @id @default(uuid())
  userId          String
  comicEndpoint   String
  chapterName     String
  chapterEndpoint String
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, comicEndpoint])
}

model Comment {
  id            String    @id @default(uuid())
  comicEndpoint String
  text          String
  userId        String
  parentId      String?
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        Comment?  @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("CommentToComment")
}

model ChapterReaction {
  id              String   @id @default(uuid())
  chapterEndpoint String   @unique
  keren           Int      @default(0)
  lucu            Int      @default(0)
  suka            Int      @default(0)
  terkejut        Int      @default(0)
  marah           Int      @default(0)
  sedih           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
